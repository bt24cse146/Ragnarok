PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Paste your complete MongoDB Atlas connection string here.
# Example: mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/relay?retryWrites=true&w=majority
MONGO_URI=

# Firebase Admin SDK — choose ONE setup method:
# Option A: path to the private service-account JSON downloaded from Firebase Console.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B: set all three values below and leave GOOGLE_APPLICATION_CREDENTIALS blank.
FIREBASE_ADMIN_PROJECT_ID=ragnarok-e1cbd
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
